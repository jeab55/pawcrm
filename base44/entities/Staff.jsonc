{
  "name": "Staff",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "description": "\u0e0a\u0e37\u0e48\u0e2d-\u0e19\u0e32\u0e21\u0e2a\u0e01\u0e38\u0e25"
    },
    "nickname": {
      "type": "string",
      "description": "\u0e0a\u0e37\u0e48\u0e2d\u0e40\u0e25\u0e48\u0e19"
    },
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "counter",
        "veterinarian",
        "assistant",
        "pharmacy",
        "cashier"
      ],
      "default": "counter",
      "description": "\u0e1a\u0e17\u0e1a\u0e32\u0e17"
    },
    "phone": {
      "type": "string",
      "description": "\u0e40\u0e1a\u0e2d\u0e23\u0e4c\u0e42\u0e17\u0e23"
    },
    "email": {
      "type": "string",
      "description": "\u0e2d\u0e35\u0e40\u0e21\u0e25"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "\u0e01\u0e33\u0e25\u0e31\u0e07\u0e43\u0e0a\u0e49\u0e07\u0e32\u0e19"
    },
    "color": {
      "type": "string",
      "enum": [
        "green",
        "blue",
        "purple",
        "orange",
        "pink",
        "teal",
        "indigo",
        "red"
      ],
      "default": "green",
      "description": "\u0e2a\u0e35\u0e1b\u0e49\u0e32\u0e22\u0e01\u0e33\u0e01\u0e31\u0e1a"
    },
    "linked_user_email": {
      "type": "string",
      "description": "\u0e2d\u0e35\u0e40\u0e21\u0e25\u0e1a\u0e31\u0e0d\u0e0a\u0e35 login \u0e17\u0e35\u0e48\u0e1c\u0e39\u0e01 (\u0e16\u0e49\u0e32\u0e21\u0e35)"
    },
    "veterinarian_id": {
      "type": "string",
      "description": "ID \u0e2a\u0e31\u0e15\u0e27\u0e41\u0e1e\u0e17\u0e22\u0e4c\u0e17\u0e35\u0e48\u0e40\u0e0a\u0e37\u0e48\u0e2d\u0e21 (\u0e16\u0e49\u0e32\u0e40\u0e1b\u0e47\u0e19\u0e2a\u0e31\u0e15\u0e27\u0e41\u0e1e\u0e17\u0e22\u0e4c)"
    },
    "notes": {
      "type": "string",
      "description": "\u0e2b\u0e21\u0e32\u0e22\u0e40\u0e2b\u0e15\u0e38"
    }
  },
  "required": [
    "full_name",
    "role"
  ]
}