{
  "name": "InsuranceClaim",
  "type": "object",
  "properties": {
    "claim_number": {
      "type": "string",
      "description": "\u0e40\u0e25\u0e02\u0e17\u0e35\u0e48\u0e40\u0e04\u0e25\u0e21"
    },
    "pet_id": {
      "type": "string",
      "description": "ID \u0e2a\u0e31\u0e15\u0e27\u0e4c\u0e40\u0e25\u0e35\u0e49\u0e22\u0e07"
    },
    "pet_name": {
      "type": "string",
      "description": "\u0e0a\u0e37\u0e48\u0e2d\u0e2a\u0e31\u0e15\u0e27\u0e4c\u0e40\u0e25\u0e35\u0e49\u0e22\u0e07"
    },
    "owner_name": {
      "type": "string",
      "description": "\u0e0a\u0e37\u0e48\u0e2d\u0e40\u0e08\u0e49\u0e32\u0e02\u0e2d\u0e07"
    },
    "invoice_id": {
      "type": "string",
      "description": "ID \u0e43\u0e1a\u0e40\u0e2a\u0e23\u0e47\u0e08"
    },
    "insurance_company": {
      "type": "string",
      "description": "\u0e1a\u0e23\u0e34\u0e29\u0e31\u0e17\u0e1b\u0e23\u0e30\u0e01\u0e31\u0e19"
    },
    "policy_number": {
      "type": "string",
      "description": "\u0e40\u0e25\u0e02\u0e01\u0e23\u0e21\u0e18\u0e23\u0e23\u0e21\u0e4c"
    },
    "claim_amount": {
      "type": "number",
      "description": "\u0e08\u0e33\u0e19\u0e27\u0e19\u0e40\u0e07\u0e34\u0e19\u0e40\u0e04\u0e25\u0e21 (\u0e1a\u0e32\u0e17)"
    },
    "approved_amount": {
      "type": "number",
      "description": "\u0e08\u0e33\u0e19\u0e27\u0e19\u0e17\u0e35\u0e48\u0e2d\u0e19\u0e38\u0e21\u0e31\u0e15\u0e34 (\u0e1a\u0e32\u0e17)"
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Submitted",
        "Review",
        "Approved",
        "Rejected",
        "Paid"
      ],
      "default": "Draft"
    },
    "submitted_date": {
      "type": "string",
      "format": "date",
      "description": "\u0e27\u0e31\u0e19\u0e17\u0e35\u0e48\u0e2a\u0e48\u0e07\u0e40\u0e04\u0e25\u0e21"
    },
    "diagnosis": {
      "type": "string",
      "description": "\u0e01\u0e32\u0e23\u0e27\u0e34\u0e19\u0e34\u0e08\u0e09\u0e31\u0e22"
    },
    "treatment_summary": {
      "type": "string",
      "description": "\u0e2a\u0e23\u0e38\u0e1b\u0e01\u0e32\u0e23\u0e23\u0e31\u0e01\u0e29\u0e32"
    },
    "notes": {
      "type": "string",
      "description": "\u0e2b\u0e21\u0e32\u0e22\u0e40\u0e2b\u0e15\u0e38"
    }
  },
  "required": [
    "pet_name",
    "owner_name",
    "insurance_company",
    "claim_amount"
  ]
}