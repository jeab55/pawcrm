      "description": "\u0e19\u0e49\u0e33\u0e2b\u0e19\u0e31\u0e01 (\u0e01\u0e01.)"
    },
    "color": {
      "type": "string",
      "description": "\u0e2a\u0e35"
    },
    "microchip_id": {
