        "\u0e41\u0e21\u0e27",
        "\u0e19\u0e01",
        "\u0e01\u0e23\u0e30\u0e15\u0e48\u0e32\u0e22",
        "\u0e2a\u0e31\u0e15\u0e27\u0e4c\u0e40\u0e25\u0e37\u0e49\u0e2d\u0e22\u0e04\u0e25\u0e32\u0e19",
        "\u0e2a\u0e31\u0e15\u0e27\u0e4c\u0e40\u0e25\u0e35\u0e49\u0e22\u0e07\u0e04\u0e25\u0e32\u0e19",
        "\u0e2d\u0e37\u0e48\u0e19\u0e46"
