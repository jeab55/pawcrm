      "description": "\u0e40\u0e25\u0e02\u0e44\u0e21\u0e42\u0e04\u0e23\u0e0a\u0e34\u0e1b"
    },
    "owner_id": {
      "type": "string",
      "description": "ID \u0e40\u0e08\u0e49\u0e32\u0e02\u0e2d\u0e07"
