    "allergies": {
      "type": "string",
      "description": "\u0e20\u0e39\u0e21\u0e34\u0e41\u0e1e\u0e49/\u0e02\u0e49\u0e2d\u0e04\u0e27\u0e23\u0e23\u0e30\u0e27\u0e31\u0e07"
