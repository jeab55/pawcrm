    },
    "owner_phone": {
      "type": "string",
      "description": "\u0e40\u0e1a\u0e2d\u0e23\u0e4c\u0e42\u0e17\u0e23\u0e40\u0e08\u0e49\u0e32\u0e02\u0e2d\u0e07"
    },
    "owner_email": {
      "type": "string",
