        "\u0e40\u0e21\u0e35\u0e22"
      ],
      "description": "\u0e40\u0e1e\u0e28"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date",
      "description": "\u0e27\u0e31\u0e19\u0e40\u0e01\u0e34\u0e14"
    },
    "weight": {
