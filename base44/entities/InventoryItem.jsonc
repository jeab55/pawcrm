{
  "name": "InventoryItem",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u0e0a\u0e37\u0e48\u0e2d\u0e22\u0e32/\u0e2d\u0e38\u0e1b\u0e01\u0e23\u0e13\u0e4c"
    },
    "sku": {
      "type": "string",
      "description": "\u0e23\u0e2b\u0e31\u0e2a SKU"
    },
    "category": {
      "type": "string",
      "enum": [
        "\u0e22\u0e32",
        "\u0e27\u0e31\u0e04\u0e0b\u0e35\u0e19",
        "\u0e2d\u0e38\u0e1b\u0e01\u0e23\u0e13\u0e4c",
        "\u0e2d\u0e32\u0e2b\u0e32\u0e23",
        "\u0e2d\u0e37\u0e48\u0e19\u0e46"
      ],
      "description": "\u0e2b\u0e21\u0e27\u0e14\u0e2b\u0e21\u0e39\u0e48"
    },
    "unit": {
      "type": "string",
      "description": "\u0e2b\u0e19\u0e48\u0e27\u0e22 \u0e40\u0e0a\u0e48\u0e19 \u0e40\u0e21\u0e47\u0e14, \u0e02\u0e27\u0e14, \u0e01\u0e25\u0e48\u0e2d\u0e07"
    },
    "quantity": {
      "type": "number",
      "default": 0,
      "description": "\u0e08\u0e33\u0e19\u0e27\u0e19\u0e04\u0e07\u0e40\u0e2b\u0e25\u0e37\u0e2d"
    },
    "min_quantity": {
      "type": "number",
      "default": 10,
      "description": "\u0e08\u0e33\u0e19\u0e27\u0e19\u0e02\u0e31\u0e49\u0e19\u0e15\u0e48\u0e33"
    },
    "cost_price": {
      "type": "number",
      "description": "\u0e23\u0e32\u0e04\u0e32\u0e15\u0e49\u0e19\u0e17\u0e38\u0e19 (\u0e1a\u0e32\u0e17)"
    },
    "sell_price": {
      "type": "number",
      "description": "\u0e23\u0e32\u0e04\u0e32\u0e02\u0e32\u0e22 (\u0e1a\u0e32\u0e17)"
    },
    "expiry_date": {
      "type": "string",
      "format": "date",
      "description": "\u0e27\u0e31\u0e19\u0e2b\u0e21\u0e14\u0e2d\u0e32\u0e22\u0e38"
    },
    "supplier": {
      "type": "string",
      "description": "\u0e1c\u0e39\u0e49\u0e08\u0e33\u0e2b\u0e19\u0e48\u0e32\u0e22"
    },
    "is_controlled": {
      "type": "boolean",
      "default": false,
      "description": "\u0e22\u0e32\u0e04\u0e27\u0e1a\u0e04\u0e38\u0e21"
    },
    "notes": {
      "type": "string",
      "description": "\u0e2b\u0e21\u0e32\u0e22\u0e40\u0e2b\u0e15\u0e38"
    }
  },
  "required": [
    "name",
    "category",
    "quantity"
  ]
}