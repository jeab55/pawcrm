{
  "name": "ClinicSettings",
  "type": "object",
  "properties": {
    "clinic_name": {
      "type": "string",
      "description": "\u0e0a\u0e37\u0e48\u0e2d\u0e04\u0e25\u0e34\u0e19\u0e34\u0e01"
    },
    "license_number": {
      "type": "string",
      "description": "\u0e40\u0e25\u0e02\u0e17\u0e35\u0e48\u0e43\u0e1a\u0e2d\u0e19\u0e38\u0e0d\u0e32\u0e15"
    },
    "email": {
      "type": "string",
      "description": "\u0e2d\u0e35\u0e40\u0e21\u0e25"
    },
    "phone": {
      "type": "string",
      "description": "\u0e40\u0e1a\u0e2d\u0e23\u0e4c\u0e42\u0e17\u0e23"
    },
    "address": {
      "type": "string",
      "description": "\u0e17\u0e35\u0e48\u0e2d\u0e22\u0e39\u0e48"
    },
    "timezone": {
      "type": "string",
      "default": "Asia/Bangkok",
      "description": "Timezone"
    },
    "tax_id": {
      "type": "string",
      "description": "\u0e40\u0e25\u0e02\u0e1c\u0e39\u0e49\u0e40\u0e2a\u0e35\u0e22\u0e20\u0e32\u0e29\u0e35 13 \u0e2b\u0e25\u0e31\u0e01"
    },
    "promptpay_id": {
      "type": "string",
      "description": "PromptPay ID"
    },
    "vat_registered": {
      "type": "boolean",
      "default": false,
      "description": "\u0e08\u0e14\u0e17\u0e30\u0e40\u0e1a\u0e35\u0e22\u0e19 VAT"
    },
    "vat_rate": {
      "type": "number",
      "default": 7,
      "description": "\u0e2d\u0e31\u0e15\u0e23\u0e32 VAT (%)"
    },
    "line_channel_token": {
      "type": "string",
      "description": "LINE Channel Access Token"
    },
    "line_channel_secret": {
      "type": "string",
      "description": "LINE Channel Secret"
    },
    "line_webhook_url": {
      "type": "string",
      "description": "LINE Webhook URL"
    },
    "current_plan": {
      "type": "string",
      "enum": [
        "Starter",
        "Pro",
        "Growth"
      ],
      "default": "Starter"
    }
  },
  "required": [
    "clinic_name"
  ]
}