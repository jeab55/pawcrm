{
  "name": "Visit",
  "type": "object",
  "properties": {
    "queue_number": {
      "type": "number",
      "description": "\u0e40\u0e25\u0e02\u0e04\u0e34\u0e27"
    },
    "pet_id": {
      "type": "string",
      "description": "ID \u0e2a\u0e31\u0e15\u0e27\u0e4c\u0e40\u0e25\u0e35\u0e49\u0e22\u0e07"
    },
    "pet_name": {
      "type": "string",
      "description": "\u0e0a\u0e37\u0e48\u0e2d\u0e2a\u0e31\u0e15\u0e27\u0e4c\u0e40\u0e25\u0e35\u0e49\u0e22\u0e07"
    },
    "owner_name": {
      "type": "string",
      "description": "\u0e0a\u0e37\u0e48\u0e2d\u0e40\u0e08\u0e49\u0e32\u0e02\u0e2d\u0e07"
    },
    "owner_phone": {
      "type": "string",
      "description": "\u0e40\u0e1a\u0e2d\u0e23\u0e4c\u0e42\u0e17\u0e23"
    },
    "species": {
      "type": "string",
      "description": "\u0e0a\u0e19\u0e34\u0e14\u0e2a\u0e31\u0e15\u0e27\u0e4c"
    },
    "status": {
      "type": "string",
      "enum": [
        "Waiting",
        "In Exam",
        "Pharmacy Pending",
        "Completed",
        "Cancelled"
      ],
      "default": "Waiting",
      "description": "\u0e2a\u0e16\u0e32\u0e19\u0e30\u0e04\u0e34\u0e27"
    },
    "check_in_time": {
      "type": "string",
      "format": "date-time",
      "description": "\u0e40\u0e27\u0e25\u0e32\u0e40\u0e0a\u0e47\u0e04\u0e2d\u0e34\u0e19"
    },
    "exam_start_time": {
      "type": "string",
      "format": "date-time",
      "description": "\u0e40\u0e27\u0e25\u0e32\u0e40\u0e23\u0e34\u0e48\u0e21\u0e15\u0e23\u0e27\u0e08"
    },
    "completed_time": {
      "type": "string",
      "format": "date-time",
      "description": "\u0e40\u0e27\u0e25\u0e32\u0e40\u0e2a\u0e23\u0e47\u0e08\u0e2a\u0e34\u0e49\u0e19"
    },
    "vet_name": {
      "type": "string",
      "description": "\u0e2a\u0e31\u0e15\u0e27\u0e41\u0e1e\u0e17\u0e22\u0e4c"
    },
    "reason": {
      "type": "string",
      "description": "\u0e2d\u0e32\u0e01\u0e32\u0e23/\u0e40\u0e2b\u0e15\u0e38\u0e1c\u0e25\u0e21\u0e32\u0e1e\u0e1a"
    },
    "diagnosis": {
      "type": "string",
      "description": "\u0e01\u0e32\u0e23\u0e27\u0e34\u0e19\u0e34\u0e08\u0e09\u0e31\u0e22"
    },
    "treatment": {
      "type": "string",
      "description": "\u0e01\u0e32\u0e23\u0e23\u0e31\u0e01\u0e29\u0e32"
    },
    "prescriptions": {
      "type": "array",
      "description": "\u0e22\u0e32\u0e17\u0e35\u0e48\u0e2a\u0e31\u0e48\u0e07 [{inventory_item_id, name, sku, qty, unit, notes}]"
    },
    "has_meds": {
      "type": "boolean",
      "default": false,
      "description": "\u0e21\u0e35\u0e22\u0e32\u0e17\u0e35\u0e48\u0e2a\u0e31\u0e48\u0e07"
    },
    "dispensed": {
      "type": "boolean",
      "default": false,
      "description": "\u0e08\u0e48\u0e32\u0e22\u0e22\u0e32\u0e41\u0e25\u0e49\u0e27"
    },
    "notes": {
      "type": "string",
      "description": "\u0e2b\u0e21\u0e32\u0e22\u0e40\u0e2b\u0e15\u0e38"
    }
  },
  "required": [
    "queue_number",
    "pet_name",
    "owner_name",
    "status"
  ]
}