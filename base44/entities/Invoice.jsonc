{
  "name": "Invoice",
  "type": "object",
  "properties": {
    "invoice_number": {
      "type": "string",
      "description": "\u0e40\u0e25\u0e02\u0e17\u0e35\u0e48\u0e43\u0e1a\u0e40\u0e2a\u0e23\u0e47\u0e08"
    },
    "pet_id": {
      "type": "string",
      "description": "ID \u0e2a\u0e31\u0e15\u0e27\u0e4c\u0e40\u0e25\u0e35\u0e49\u0e22\u0e07"
    },
    "pet_name": {
      "type": "string",
      "description": "\u0e0a\u0e37\u0e48\u0e2d\u0e2a\u0e31\u0e15\u0e27\u0e4c\u0e40\u0e25\u0e35\u0e49\u0e22\u0e07"
    },
    "owner_name": {
      "type": "string",
      "description": "\u0e0a\u0e37\u0e48\u0e2d\u0e40\u0e08\u0e49\u0e32\u0e02\u0e2d\u0e07"
    },
    "owner_phone": {
      "type": "string",
      "description": "\u0e40\u0e1a\u0e2d\u0e23\u0e4c\u0e42\u0e17\u0e23"
    },
    "appointment_id": {
      "type": "string",
      "description": "ID \u0e19\u0e31\u0e14\u0e2b\u0e21\u0e32\u0e22"
    },
    "items": {
      "type": "array",
      "description": "\u0e23\u0e32\u0e22\u0e01\u0e32\u0e23 [{name, qty, unit_price, total}]"
    },
    "subtotal": {
      "type": "number",
      "description": "\u0e23\u0e27\u0e21\u0e01\u0e48\u0e2d\u0e19 VAT"
    },
    "vat_amount": {
      "type": "number",
      "default": 0,
      "description": "VAT"
    },
    "discount": {
      "type": "number",
      "default": 0,
      "description": "\u0e2a\u0e48\u0e27\u0e19\u0e25\u0e14"
    },
    "total": {
      "type": "number",
      "description": "\u0e22\u0e2d\u0e14\u0e23\u0e27\u0e21"
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Pending",
        "Paid",
        "Cancelled"
      ],
      "default": "Draft"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "\u0e40\u0e07\u0e34\u0e19\u0e2a\u0e14",
        "\u0e42\u0e2d\u0e19\u0e18\u0e19\u0e32\u0e04\u0e32\u0e23",
        "\u0e1a\u0e31\u0e15\u0e23\u0e40\u0e04\u0e23\u0e14\u0e34\u0e15",
        "PromptPay",
        "\u0e2d\u0e37\u0e48\u0e19\u0e46"
      ],
      "description": "\u0e27\u0e34\u0e18\u0e35\u0e0a\u0e33\u0e23\u0e30\u0e40\u0e07\u0e34\u0e19"
    },
    "paid_date": {
      "type": "string",
      "format": "date",
      "description": "\u0e27\u0e31\u0e19\u0e17\u0e35\u0e48\u0e0a\u0e33\u0e23\u0e30"
    },
    "notes": {
      "type": "string",
      "description": "\u0e2b\u0e21\u0e32\u0e22\u0e40\u0e2b\u0e15\u0e38"
    },
    "received_by": {
      "type": "string",
      "description": "\u0e23\u0e31\u0e1a\u0e0a\u0e33\u0e23\u0e30\u0e42\u0e14\u0e22"
    }
  },
  "required": [
    "pet_name",
    "owner_name",
    "total"
  ]
}